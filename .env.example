# ===== 机器人基本配置 =====
BOT_NAME=BoB
BOT_ROOM=lounge
BOT_PASSWORD=
BOT_SERVER_URL=wss://hack.chat/chat-ws
BOT_PREFIX=
# 管理员，格式 nick:trip，多个用逗号分隔
BOT_ADMINS=

# ===== 数据库 / 数据目录 =====
DATABASE_PATH=data/aibob.db
DATA_DIR=data/games
LOG_LEVEL=INFO

# ===== 健康监控 =====
HEALTH_CHECK_INTERVAL=10
HEALTH_INACTIVE_TIMEOUT=300

# ===== AI（多 Provider fallback）=====
# Provider 列表，按优先级排列，逗号分隔
# 每个 provider 需要配置对应的 AI_<NAME>_API_KEY / _BASE_URL / _MODEL
AI_PROVIDERS=kilo,nvidia

# 主力: Kilo AI（稳定）
AI_KILO_API_KEY=
AI_KILO_BASE_URL=https://api.kilo.ai/api/openrouter
AI_KILO_MODEL=kilo-auto/free

# 保底: NVIDIA NIM（免费额度）
AI_NVIDIA_API_KEY=
AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ===== 联网搜索（Tavily）=====
TAVILY_API_KEYS=

# ===== 加密货币报价（Finnhub）=====
FINNHUB_API_KEY=

# ===== Gyazo 图片上传（Wordle 图片输出）=====
GYAZO_TOKEN=

# ===== Supabase（CodeAgent + 友情链接）=====
# 直接用官方 URL，不需要代理
SUPABASE_URL=https://xxx.supabase.co
# publishable key 或 service key 均可
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=Code
CODE_PREVIEW_BASE=https://bob.supage.eu.org/code

# ===== 限流 =====
RATE_GLOBAL_MAX=10
RATE_GLOBAL_WINDOW=60
RATE_AI_MAX=5
RATE_AI_WINDOW=60

# AI 并发上限（256MB/0.25CPU 默认 3，后台动态监测内存自动调整）
AI_CONCURRENCY=3

# ===== 游戏超时（秒）=====
GAME_WORDLE_TIMEOUT=600
GAME_IDIOM_TIMEOUT=30
GAME_DICE_TIMEOUT=60
GAME_ZJH_TIMEOUT=300

# ===== 奖励配置 =====
REWARD_CHECKIN_BASE=10
REWARD_CHECKIN_RANK_BONUS=20,15,10
REWARD_CHECKIN_STREAK_3=5
REWARD_CHECKIN_STREAK_7=15
REWARD_CHECKIN_STREAK_15=30
REWARD_CHECKIN_STREAK_30=50
REWARD_WORDLE_WIN=30
REWARD_UNO_WIN=50
REWARD_GUESS_WIN=50
REWARD_NUMBER_WIN=25
REWARD_IDIOM_WIN=100,60,30

# ===== 商店价格 =====
SHOP_CUSTOM_WELCOME_PRICE=50
SHOP_CUSTOM_WELCOME_UPDATE_PRICE=1
SHOP_DOUBLE_CARD_PRICE=60
SHOP_SKIP_CARD_PRICE=40
SHOP_HINT_CARD_PRICE=30
SHOP_MYSTERY_BOX_PRICE=80

# ===== 广告 =====
ADS_POST_COST=20
ADS_DAILY_VIEW_LIMIT=3
ADS_VIEW_REWARD_MIN=10
ADS_VIEW_REWARD_MAX=50
ADS_AD_VIEW_CAP=5

# ===== HTTP API Server =====
# 设为 1 启用，0 关闭。需绑定 :: 和端口 8300~8499
# Vercel 前端通过 /api/* 代理调用，密钥在服务端 env var，浏览器不暴露
API_ENABLED=0
API_HOST=::
API_PORT=8300
# 随机密钥，请修改为自己的，Vercel 侧需配置相同值
API_KEY=
